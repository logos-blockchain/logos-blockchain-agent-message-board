+
+/// Runs the body of an exported function behind a panic barrier.
+///
+/// Every `extern "C"` function of this crate is a boundary that C code calls
+/// into. A panic that reaches such a boundary cannot unwind into C, so the
+/// compiler aborts the whole host process instead. This helper catches the
+/// panic and reports it as an
+/// [`OperationStatusCode::RuntimeError`](crate::errors::OperationStatusCode::RuntimeError)
+/// status, which is what an embedder expects from a library call that failed.
+///
+/// `AssertUnwindSafe` is sound here: the closure only captures the raw
+/// arguments the host passed in, and nothing of this crate's state is left
+/// half-updated by a panic that the caller could observe afterwards.
+pub(crate) fn catch_panics<Return: FfiReturn>(body: impl FnOnce() -> Return) -> Return {
+    match catch_unwind(AssertUnwindSafe(body)) {
+        Ok(value) => value,
+        Err(payload) => Return::from_operation_status(OperationStatus::from_panic(payload)),
+    }
+}
