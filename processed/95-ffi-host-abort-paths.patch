+/// Delivers subscription events to the embedder's callback from a dedicated
+/// OS thread rather than from a runtime worker.
+///
+/// Every other exported function reaches the node through
+/// `Handle::block_on`, which tokio refuses (by panicking) on a thread that is
+/// already driving the runtime. Running the callback on its own thread makes
+/// calling back into this library from a callback legal. Events are queued
+/// unboundedly, so a slow callback delays delivery but never blocks the node.
+///
+/// Dropping the returned sender ends the thread. When `end_with_null` is set,
+/// the thread then calls the callback exactly once with NULL.
+fn spawn_callback_thread<Event>(
+    name: &str,
+    mut on_event: BoxedCallback<*const c_char>,
+    as_ptr: impl Fn(&Event) -> *const c_char + Send + 'static,
+    end_with_null: bool,
+) -> Result<mpsc::Sender<Event>, OperationStatus>
+where
+    Event: Send + 'static,
+{
+    let (sender, receiver) = mpsc::channel::<Event>();
+    thread::Builder::new()
+        .name(name.to_owned())
+        .spawn(move || {
+            while let Ok(event) = receiver.recv() {
+                on_event(as_ptr(&event));
+            }
+            if end_with_null {
+                on_event(std::ptr::null());
+            }
+        })
+        .map_err(|error| {
+            OperationStatus::error(
+                OperationStatusCode::RuntimeError,
+                format!("Could not spawn the callback thread: {error}"),
+            )
+        })?;
+    Ok(sender)
+}
+
+/// Serializes `value` as JSON into a NUL-terminated string, or logs why it
+/// could not be.
+fn to_json_cstring<T: Serialize>(scope: &str, value: &T) -> Option<CString> {
+    let json = serde_json::to_string(value)
+        .map_err(|error| {
+            logging::error!(scope, "Could not serialize an event: {error}");
+        })
+        .ok()?;
+    CString::new(json)
+        .map_err(|error| {
+            logging::error!(scope, "Event JSON contains a NUL byte: {error}");
+        })
+        .ok()
+}
